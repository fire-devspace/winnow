#!/usr/bin/env python3
"""Generate current feature pages from documented, real app test journeys."""
import argparse
import html
import json
import re
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TEST_PATH = "UITests/WinnowAppUITests.swift"
SOURCE = "https://github.com/winnowwallet/winnow/blob/main/"
RESULTS = "https://github.com/winnowwallet/winnow/actions/workflows/node-tests.yml"

def load_journeys(root):
    journeys = json.loads((root / "docs/journeys.json").read_text())
    source = (root / TEST_PATH).read_text()
    matches = list(re.finditer(r"^    func (test\d+\w+)\(", source, re.M))
    cases = {}
    for index, match in enumerate(matches):
        name = match.group(1)
        if name == "test00CanSpawnHostProcesses":
            continue
        end = matches[index + 1].start() if index + 1 < len(matches) else len(source)
        cases[name] = (source.count("\n", 0, match.start()) + 1, source[match.start():end])
    seen, ids = set(), set()
    for journey in journeys:
        identity = journey["id"]
        if not re.fullmatch(r"[a-z][a-z0-9-]*", identity) or identity in ids:
            raise ValueError(f"duplicate or invalid journey id: {identity}")
        ids.add(identity)
        if journey["section"] not in {"everyday", "advanced"} or not journey["tests"]:
            raise ValueError(f"{identity}: choose a section and at least one app test")
        for test in journey["tests"]:
            if test not in cases:
                raise ValueError(f"{identity}: missing app test {test}")
            seen.add(test)
        if image := journey.get("image"):
            if not re.fullmatch(r"[a-z0-9-]+", image):
                raise ValueError(f"{identity}: invalid screenshot name")
            if not (root / f"docs/screenshots/{image}.png").is_file():
                raise ValueError(f"{identity}: missing screenshot {image}")
            if not any(f'"{image}", testCase: self' in cases[test][1] for test in journey["tests"]):
                raise ValueError(f"{identity}: screenshot was not captured by its app tests")
        if guide := journey.get("guide"):
            if not guide.startswith("/") or not (root / "docs" / (guide[1:] + ".html")).is_file():
                raise ValueError(f"{identity}: missing local guide {guide}")
    if unowned := set(cases) - seen:
        raise ValueError("app tests need a documented journey: " + ", ".join(sorted(unowned)))
    return journeys, cases

def escape(value):
    return html.escape(value, quote=True)

def card(journey, cases):
    parts = [f'<section class="journey" id="{journey["id"]}">']
    parts.append(f'<h2>{escape(journey["title"])}</h2><p>{escape(journey["description"])}</p>')
    if image := journey.get("image"):
        parts.append(f'<img class="app-shot" src="screenshots/{image}.png" width="1320" height="2868" loading="lazy" alt="{escape(journey["title"])} in the signet test app.">')
    if limitation := journey.get("limitations"):
        parts.append(f'<p class="limit"><strong>Know before using it:</strong> {escape(limitation)}</p>')
    if guide := journey.get("guide"):
        parts.append(f'<p><a href="{guide}">Read the advanced guide</a></p>')
    parts.append('<details><summary>How this journey is checked</summary><ol>')
    parts.extend(f'<li>{escape(step)}</li>' for step in journey["journey"])
    parts.append('</ol><p>App scenarios:')
    parts.append(", ".join(f'<a href="{SOURCE}{TEST_PATH}#L{cases[test][0]}">{escape(test)}</a>' for test in journey["tests"]))
    parts.append(f'. <a href="{RESULTS}">Inspect test runs and their results</a>.</p></details></section>')
    return "\n".join(parts)

def page(section, journeys, cases):
    advanced = section == "advanced"
    title = "Advanced wallet journeys" if advanced else "A Bitcoin wallet, from first setup to shared savings"
    intro = ("Turn on Advanced mode for explicit vault policies, signing exchanges, fee replacement, and peer controls."
             if advanced else "Create a wallet on your phone, pay people, and choose when a payment needs more than one approval.")
    selected = [j for j in journeys if j["section"] == section]
    content = "\n".join(card(j, cases) for j in selected)
    links = " ".join(f'<a href="#{j["id"]}">{escape(j["title"])}</a>' for j in selected)
    cta = "" if advanced else '<p><a class="action" href="https://testflight.apple.com/join/83djpNE7">Get early access on TestFlight</a></p>'
    return f"""<!doctype html>
<!-- Generated by scripts/build-site from docs/journeys.json and the app test source. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{escape(title)} — Winnow</title>
<meta name="description" content="{escape(intro)}">
<link rel="canonical" href="https://winnowwallet.com/{'advanced' if advanced else ''}">
<link rel="stylesheet" href="site.css">
<style>
main{{max-width:64rem}} .journey{{display:flow-root;padding-bottom:1.2rem}}
.app-shot{{float:right;width:min(34%,220px);height:auto;margin:0 0 1.5rem 2rem;border:1px solid var(--rule);border-radius:1.4rem}}
.journey details{{margin:1.2rem 0;color:var(--ink-2)}} summary{{cursor:pointer;color:var(--seed);font-weight:600}}
.journey ol{{margin:1rem 0 1rem 1.3rem}} .journey li{{margin:.45rem 0}} .journey details a{{overflow-wrap:anywhere}}
.action{{display:inline-block;background:var(--seed);color:var(--paper);padding:.7rem 1rem;border-radius:.6rem;font-weight:650}}
.jump-links{{display:flex;flex-wrap:wrap;gap:.6rem 1rem;margin:1.5rem 0;font-size:.95rem}}
.limit{{border-left:2px solid var(--rule-2);padding-left:1rem}}
@media(max-width:35rem){{.app-shot{{float:none;display:block;width:190px;margin:1.2rem auto}}}}
</style>
</head>
<body>
<header class="topbar"><div class="bar">
<a class="mark" href="/"><b>&#8383;</b> Winnow</a>
<nav class="links" aria-label="Main"><a href="/">Everyday use</a><a href="/advanced">Advanced</a><a href="/testing">Testing</a><a href="/roadmap">Roadmap</a><a href="https://github.com/winnowwallet/winnow">Source</a></nav>
</div></header>
<main>
<p class="lede">Early access · open source · iPhone</p>
<h1>{escape(title)}</h1>
<p class="lede">{escape(intro)}</p>
{cta}
<p>Wallet reads use Bitcoin peers and compact block filters. Keys are stored in this device’s Keychain; secret exports are explicit. No address-query service supplies the wallet’s balance.</p>
<nav class="jump-links" aria-label="Journeys">{links}</nav>
{content}
<section id="evidence"><h2>What the evidence means</h2>
<p>Each journey above links to tests that drive the actual app against a disposable signet node. Images show test wallets. A screenshot or a test’s presence in the source is not a passing result: inspect the linked run for its revision, failures, and result bundle.</p>
<p>Cryptographic vectors, hostile-peer checks, storage failures, and Bitcoin Core comparisons support these journeys. They establish properties that a successful screen flow alone cannot show. <a href="/testing">Explore the testing suites and their artifacts</a>, or read the <a href="{SOURCE}docs/testing.md">testing and feature policy</a>.</p>
<p>Simulator results do not establish hardware security, battery life, or independent security review. <a href="/roadmap">Those release requirements and future features live on the separate roadmap</a>.</p>
</section>
{"<section id='debugging'><h2>Local debugging tools</h2><p>Use winnow-debug for environment checks, simulator diagnostics, release-data generation, and network soak runs. These are operator tools, with their own command and protocol checks.</p><p><a href='" + SOURCE + "Tools/Debug/README.md'>Debugging commands and their limits</a></p></section>" if advanced else "<p><a href='/advanced'>Explore advanced wallet journeys</a> · <a href='/roadmap'>See planned work</a></p>"}
</main>
<footer><div class="bar"><a href="/">Winnow</a> · <a href="/advanced">Advanced</a> · <a href="/testing">Testing</a> · <a href="/roadmap">Roadmap</a> · <a href="/privacy">Privacy</a> · <a href="/architecture">How it works</a></div></footer>
</body>
</html>
"""

def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="fail if generated pages are stale")
    args = parser.parse_args()
    journeys, cases = load_journeys(ROOT)
    for section, name in [("everyday", "index.html"), ("advanced", "advanced.html")]:
        output = ROOT / "docs" / name
        rendered = page(section, journeys, cases)
        if args.check:
            if not output.exists() or output.read_text() != rendered:
                raise SystemExit(f"{name} is stale; run scripts/build-site")
        else:
            output.write_text(rendered)
    print(f"{len(journeys)} documented journeys own {len(cases)} app scenarios")

if __name__ == "__main__":
    main()
