#!/bin/bash
# Offline acceptance-tool checks; no wallet launch or public-signet activity.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
DEBUG_APP_ROOT="$PWD"
DEBUG_CHECK_DIR="$(mktemp -d)"
trap 'rm -rf "$DEBUG_CHECK_DIR"' EXIT
cd "$DEBUG_CHECK_DIR"
"$DEBUG_APP_ROOT/scripts/winnow-debug" help > help.txt
grep -q 'scripts/winnow-debug diagnostics' help.txt
"$DEBUG_APP_ROOT/scripts/winnow-debug" doctor | tee doctor.txt
grep -Fq "✓ App project: $DEBUG_APP_ROOT/project.yml" doctor.txt

"$DEBUG_APP_ROOT/scripts/winnow-debug" generate --help > generate-help.txt
grep -Fq 'winnow-debug generate checkpoint' generate-help.txt
"$DEBUG_APP_ROOT/scripts/winnow-debug" soak --help > soak-help.txt
grep -Fq 'winnow-debug soak' soak-help.txt
"$DEBUG_APP_ROOT/scripts/winnow-debug" check --help > check-help.txt
grep -Fq 'winnow-debug check fallback-peers' check-help.txt

"$DEBUG_APP_ROOT/scripts/winnow-debug" inspect --help > inspect-help.txt
grep -Fq 'winnow-debug inspect tx' inspect-help.txt
