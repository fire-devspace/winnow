#!/bin/bash
# Inspect one fresh build log for warnings in this checkout's Sources/ and relocated soak driver.
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
LOG_PATH="${1:?usage: check-swift-warnings <build-log>}"

python3 - "$ROOT" "$LOG_PATH" <<'PY'
import pathlib
import re
import sys

root = pathlib.Path(sys.argv[1]).resolve()
sources = root / "Sources"
soak = root / "Tools/Debug/Sources/WinnowDebug/SoakCommand.swift"
warnings = []
pattern = re.compile(r"^(.*?):(\d+):(\d+): warning: (.*)$")

for line in pathlib.Path(sys.argv[2]).read_text(errors="replace").splitlines():
    match = pattern.match(line.strip())
    if not match:
        continue
    path = pathlib.Path(match.group(1))
    if not path.is_absolute():
        path = root / path
    try:
        path.resolve().relative_to(sources)
    except ValueError:
        if path.resolve() != soak:
            continue
    if line not in warnings:
        warnings.append(line)

if warnings:
    for warning in warnings:
        print(f"::error title=First-party Swift warning::{warning}")
    raise SystemExit(f"build emitted {len(warnings)} warning(s)")

print("Build completed without first-party warnings")
PY
