#!/usr/bin/env python3
"""Require local first-party packages and matching third-party resolutions."""
import argparse
import json
import pathlib
import re
import subprocess

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--xcode', type=pathlib.Path, metavar='DERIVED_DATA')
args = parser.parse_args()
root = pathlib.Path(__file__).resolve().parent.parent
project = (root / 'project.yml').read_text()
if not re.search(r'^  Winnow:\n    path: \.\s*$', project, re.M):
    raise SystemExit('the app must consume the root package locally')

def manifest(path):
    return json.loads(subprocess.check_output(
        ['swift', 'package', '--package-path', str(path), 'dump-package'], text=True))

def pins(path):
    return {p['identity']: (p['location'], p['state'])
            for p in json.loads(path.read_text())['pins']}

expected = pins(root / 'Package.resolved')
if set(expected) != {'swift-secp256k1'}:
    raise SystemExit('unexpected root dependency; review the monorepo dependency policy')
version = expected['swift-secp256k1'][1]['version']
remote = manifest(root)['dependencies'][0]['sourceControl'][0]
if remote['requirement'] != {'exact': [version]}:
    raise SystemExit('root manifest and lockfile disagree')
if not re.search(r'^  swift-secp256k1:\n    url: [^\n]+\n    exactVersion: '+re.escape(version)+r'\s*$', project, re.M):
    raise SystemExit('Xcode must pin the root third-party version')
if args.xcode:
    # Xcode can share the root lockfile instead of writing a workspace copy.
    # Check the actual resolved checkout state from this build in either case.
    path = args.xcode / 'SourcePackages/workspace-state.json'
    dependencies = json.loads(path.read_text())['object']['dependencies']
    actual = {d['packageRef']['identity']:
              (d['packageRef']['location'], d['state']['checkoutState'])
              for d in dependencies if d['state']['name'] == 'sourceControlCheckout'}
    if actual != expected:
        raise SystemExit('Xcode resolved dependencies differ from the root lockfile')
print('The app uses the local Winnow package and its committed third-party pin')
