#!/usr/bin/env python3
"""Generate reproducible SPDX and SLSA-shaped provenance JSON.

The document timestamp comes from the commit, not wall-clock time, and every
collection is sorted. The provenance subject is either the Git tree or an
explicit build output (a file or a canonical digest of a directory tree).
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import pathlib
import re
import subprocess
from typing import Any


def git(root: pathlib.Path, *arguments: str) -> str:
    return subprocess.check_output(
        ["git", "-C", str(root), *arguments], text=True
    ).strip()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def sha256_tree(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    entries = sorted(path.rglob("*"), key=lambda item: item.relative_to(path).as_posix())
    for entry in entries:
        relative = entry.relative_to(path).as_posix().encode()
        if entry.is_symlink():
            record = b"L\0" + relative + b"\0" + os.readlink(entry).encode() + b"\n"
        elif entry.is_file():
            record = b"F\0" + relative + b"\0" + sha256_file(entry).encode() + b"\n"
        elif entry.is_dir():
            record = b"D\0" + relative + b"\n"
        else:
            continue
        digest.update(record)
    return digest.hexdigest()


def write_json(path: pathlib.Path, value: Any) -> None:
    path.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")


def spdx_id(identity: str) -> str:
    return "SPDXRef-Package-" + re.sub(r"[^A-Za-z0-9.-]", "-", identity)


def commit_timestamp(root: pathlib.Path) -> str:
    parsed = dt.datetime.fromisoformat(git(root, "show", "-s", "--format=%cI", "HEAD"))
    return parsed.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output-dir", required=True, type=pathlib.Path)
    parser.add_argument("--subject", type=pathlib.Path)
    parser.add_argument("--subject-name", default="winnow-source-tree")
    parser.add_argument(
        "--builder-id",
        default="https://github.com/posix4e/winnow/.github/workflows/security.yml",
    )
    args = parser.parse_args()

    root = pathlib.Path(git(pathlib.Path.cwd(), "rev-parse", "--show-toplevel"))
    commit = git(root, "rev-parse", "HEAD")
    tree = git(root, "rev-parse", "HEAD^{tree}")
    resolved_path = root / "Package.resolved"
    package_path = root / "Package.swift"
    project_path = root / "project.yml"
    resolved = json.loads(resolved_path.read_text())
    pins = sorted(resolved.get("pins", []), key=lambda pin: pin["identity"])

    root_id = "SPDXRef-Package-winnow"
    packages: list[dict[str, Any]] = [
        {
            "SPDXID": root_id,
            "name": "winnow",
            "versionInfo": commit,
            "downloadLocation": "https://github.com/posix4e/winnow",
            "filesAnalyzed": False,
            "licenseConcluded": "NOASSERTION",
            "licenseDeclared": "NOASSERTION",
            "copyrightText": "NOASSERTION",
        }
    ]
    relationships: list[dict[str, str]] = [
        {
            "spdxElementId": "SPDXRef-DOCUMENT",
            "relationshipType": "DESCRIBES",
            "relatedSpdxElement": root_id,
        }
    ]
    dependencies: list[dict[str, Any]] = []

    for pin in pins:
        state = pin.get("state", {})
        revision = state.get("revision", "")
        dependency_id = spdx_id(pin["identity"])
        package: dict[str, Any] = {
            "SPDXID": dependency_id,
            "name": pin["identity"],
            "versionInfo": state.get("version") or revision,
            "downloadLocation": pin.get("location", "NOASSERTION"),
            "filesAnalyzed": False,
            "licenseConcluded": "NOASSERTION",
            "licenseDeclared": "NOASSERTION",
            "copyrightText": "NOASSERTION",
        }
        if re.fullmatch(r"[0-9a-fA-F]{40}", revision):
            package["checksums"] = [{"algorithm": "SHA1", "checksumValue": revision.lower()}]
        packages.append(package)
        relationships.append(
            {
                "spdxElementId": root_id,
                "relationshipType": "DEPENDS_ON",
                "relatedSpdxElement": dependency_id,
            }
        )
        dependencies.append(
            {
                "uri": pin.get("location", "NOASSERTION"),
                "digest": {"sha1": revision},
                "name": pin["identity"],
                "version": state.get("version"),
            }
        )

    spdx = {
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": f"winnow-{commit[:12]}",
        "documentNamespace": f"https://github.com/posix4e/winnow/sbom/{commit}",
        "creationInfo": {
            "created": commit_timestamp(root),
            "creators": ["Tool: winnow-generate-supply-chain-metadata-1"],
        },
        "packages": packages,
        "relationships": relationships,
    }

    if args.subject:
        subject_path = args.subject.resolve()
        if not subject_path.exists():
            raise SystemExit(f"provenance subject does not exist: {subject_path}")
        subject_digest = sha256_tree(subject_path) if subject_path.is_dir() else sha256_file(subject_path)
        subject = [{"name": args.subject_name, "digest": {"sha256": subject_digest}}]
    else:
        subject = [{"name": args.subject_name, "digest": {"sha1": tree}}]

    materials = [
        {"uri": "git+https://github.com/posix4e/winnow.git", "digest": {"sha1": commit}},
        {"uri": "file:Package.swift", "digest": {"sha256": sha256_file(package_path)}},
        {"uri": "file:Package.resolved", "digest": {"sha256": sha256_file(resolved_path)}},
        {"uri": "file:project.yml", "digest": {"sha256": sha256_file(project_path)}},
        *dependencies,
    ]
    materials.sort(key=lambda material: material["uri"])

    provenance = {
        "_type": "https://in-toto.io/Statement/v1",
        "subject": subject,
        "predicateType": "https://slsa.dev/provenance/v1",
        "predicate": {
            "buildDefinition": {
                "buildType": "https://github.com/posix4e/winnow/build-types/swift-package-and-xcode/v1",
                "externalParameters": {
                    "configuration": "release",
                    "packageLock": "Package.resolved",
                },
                "internalParameters": {},
                "resolvedDependencies": materials,
            },
            "runDetails": {
                "builder": {"id": args.builder_id},
                "metadata": {"invocationId": commit},
            },
        },
    }

    args.output_dir.mkdir(parents=True, exist_ok=True)
    write_json(args.output_dir / "winnow.spdx.json", spdx)
    write_json(args.output_dir / "winnow-build-provenance.json", provenance)


if __name__ == "__main__":
    main()
