.build/
build/
DerivedData/
WinnowApp.xcodeproj/
Package.resolved
*.xcuserstate
.DS_Store

# Xcode leftovers that land outside build/ when a derived-data path is overridden
xcuserdata/
.swiftpm/
*.hmap
*.dSYM
*.dSYM.zip
*.xcarchive
*.ipa

# Signing material. An embedded.mobileprovision already ships inside every
# .xcarchive; these rules catch one exported anywhere else.
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# docs/*.html is built by .github/workflows/site.yml (pandoc + _template.html)
# from the matching .md on every deploy. Committing the output means carrying a
# copy that goes stale the next time the template changes. The pages below have
# no .md source — they are written by hand and must stay tracked.
docs/*.html
!docs/_template.html
!docs/architecture.html
!docs/index.html
!docs/papers.html
!docs/present.html
