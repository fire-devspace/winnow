.build/
build/
DerivedData/
WinnowApp.xcodeproj/
# Winnow is an application, so commit the resolved dependency revision. The
# manifest's exact version is useful but does not by itself record the audited
# source commit used by a build.
*.xcuserstate
.DS_Store

# Xcode leftovers that land outside build/ when a derived-data path is overridden
xcuserdata/
.swiftpm/
*.hmap
*.dSYM
*.dSYM.zip
*.xcarchive
*.ipa

# Signing material. An embedded.mobileprovision already ships inside every
# .xcarchive; these rules catch one exported anywhere else.
*.mobileprovision
*.p12
*.cer
*.certSigningRequest
